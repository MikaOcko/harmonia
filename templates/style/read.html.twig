{% extends 'base.html.twig' %}

{% block title %}Genres{% endblock %}

{% block body %}
    <h1 class="text-center py-5">Genre: {{style.name }}</h1>
    <div class="text-center">
        <strong>
            <p style="color:{{ style.color }};">Nombre total de morceaux : {{ style.tracks|length}}</p>
        </strong>
    </div>
    <div class="container d-flex justify-content-center mb-5">
        <table class="table">
            <thead>
                <tr>
                <th scope="col">Titre</th>
                <th scope="col">N° piste</th>
                <th scope="col">Album</th>
                </tr>
            </thead>
            <tbody>
                {% for track in style.tracks %} 
                    <tr>
                            <td>
                                <div class="d-flex align-item-center justify-content-between py-1">
                                    <p>🎵 {{ track.title}}</p>
                                </div>
                            </td>
                            <td>
                                {{ track.number }}
                            </td>
                            <td>
                                {{ track.album.title }}
                            </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
