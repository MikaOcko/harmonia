{% extends 'base.html.twig' %}

{% block title %}Détails Album{% endblock %}

{% block body %}
    <h1 class="text-center py-5">Détails de {{ album.title }}</h1>
    <div class="container d-flex justify-content-center mb-5">
        <div class="card" style="width:50%;">
            <img src="{{ asset(album.imgPath)}}" class="card-img-top" alt="...">
            <div class="card-body">
                <p class="card-text">Sortie le {{ album.releaseDate | date('d/m/Y') }}</p>
                <p class="card-text">Type : {{ album.type.name }}</p>
                <p class="card-text">Liste des morceaux :</p>
                <ul style="list-style:none;">
                    {% for track in album.tracks %}
                        <li>🎵 n°{{ track.number }} - {{ track.title }}</li>
                        <li>Durée : {{ track.duration }} secondes</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
