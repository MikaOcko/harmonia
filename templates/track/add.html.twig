{% extends 'base.html.twig' %}

{% block title %}Musique{% endblock %}

{% block body %}
    <h1 class="text-center py-5">Ajouter un morceau</h1>

    {{form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.duration) }}
        {{ form_row(form.number) }}
        {{ form_row(form.album) }}
        {{ form_row(form.styles) }}
        {{ form_row(form.isExplicitContent) }}
        <button type="submit" class="btn btn-success">Valider</button>
    {{ form_end(form) }}
{% endblock %}