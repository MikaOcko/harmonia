{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1 class="text-center py-2">Bienvenue chez Simplon records</h1>
    <div class="d-flex justify-content-end mx-5 my-3">
        <a href="{{ path('app_album_add') }}" class="btn btn-success"> + Ajouter un album</a>
    </div>
    {# les EP #}
    <section>
        <h2 class="text-center py-2">Les EP</h2>
        <div class="container">
            <div class="row  gap-3">
                {%for ep in epType %}
                    <div class="col-md-4">
                        {% include 'components/album-card.html.twig' with {album:ep}%}
                    </div>
                {% endfor %}

            </div>
        </div>
    </section>
    {# les albums #}
    <section>
        <h2 class="text-center py-2">Les albums</h2>
        <div class="container">
            <div class="row  gap-3">
                {%for album in albumType %}
                    <div class="col-md-4">
                        {% include 'components/album-card.html.twig'%}
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {# les single #}
    <section>
        <h2 class="text-center py-2">Les singles</h2>
        <div class="container">
            <div class="row  gap-3">
                {%for single in singleType %}
                <div class="col-md-4">
                    {% include 'components/album-card.html.twig' with {album:single}%}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
